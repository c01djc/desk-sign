<Window x:Class="DeskSign.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:DeskSign.Controls"
        Title="桌签生成器"
        Icon="Assets/app.ico"
        Width="1120"
        Height="860"
        MinWidth="960"
        MinHeight="760"
        WindowStartupLocation="CenterScreen"
        Background="#E7E0D4"
        FontFamily="Microsoft YaHei UI"
        Foreground="{StaticResource Text}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        AllowDrop="True"
        PreviewDragOver="Window_PreviewDragOver"
        Drop="Window_Drop">
    <Grid Margin="18">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="400"/>
            <ColumnDefinition Width="16"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="{StaticResource Card}" CornerRadius="16" Padding="22">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Image Source="Assets/icon.png" Width="48" Height="48" RenderOptions.BitmapScalingMode="HighQuality"/>
                    <StackPanel Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center">
                        <TextBlock Text="桌签生成器" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                        <TextBlock Text="A4 对折桌签  ·  开发者 c0ldjc" Margin="0,2,0,0" Foreground="{StaticResource Muted}" FontSize="12"/>
                    </StackPanel>
                    <Border Grid.Column="2" Background="{StaticResource Ink}" CornerRadius="8" Padding="8,3" VerticalAlignment="Center">
                        <TextBlock Text="1.0" Foreground="#F6F1E7" FontSize="12"/>
                    </Border>
                </Grid>

                <Button DockPanel.Dock="Bottom"
                        Margin="0,16,0,0"
                        Style="{StaticResource PrimaryButton}"
                        Content="{Binding GenerateButtonText}"
                        ToolTip="{Binding GenerateToolTip}"
                        IsEnabled="{Binding CanGenerate}"
                        Click="Generate_Click"/>

                <TextBlock DockPanel.Dock="Bottom"
                           Text="{Binding LayoutWarning}"
                           Foreground="{StaticResource Cinnabar}"
                           TextWrapping="Wrap"
                           Margin="0,12,0,0"
                           Visibility="{Binding HasWarning, Converter={StaticResource BoolToVis}}"/>

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*" MinHeight="96"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0" Text="名单" Style="{StaticResource FieldLabel}" Margin="0,10,0,6"/>
                    <Grid Grid.Row="1">
                        <TextBox Style="{StaticResource PlainBox}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 VerticalScrollBarVisibility="Auto"
                                 FontSize="15"
                                 Text="{Binding NamesText, UpdateSourceTrigger=PropertyChanged}"/>
                        <TextBlock Margin="14,10,14,0"
                                   Foreground="#B0A89C"
                                   TextWrapping="Wrap"
                                   IsHitTestVisible="False"
                                   Visibility="{Binding HasNames, Converter={StaticResource InverseBoolToVis}}"
                                   Text="每行一个姓名。可以导入 TXT，也可以把文件拖到窗口里。"/>
                    </Grid>
                    <DockPanel Grid.Row="2" Margin="0,8,0,0">
                        <TextBlock Text="{Binding NameCountText}" Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="导入名单" Style="{StaticResource GhostButton}" Margin="0,0,8,0" ToolTip="Ctrl+O" Click="Import_Click"/>
                            <Button Content="清空" Style="{StaticResource GhostButton}" Click="Clear_Click"/>
                        </StackPanel>
                    </DockPanel>

                    <StackPanel Grid.Row="3">
                        <TextBlock Text="字体" Style="{StaticResource FieldLabel}"/>
                        <ComboBox ItemsSource="{Binding Fonts}"
                                  SelectedItem="{Binding FontName}"
                                  Height="38"
                                  FontSize="14"
                                  VerticalContentAlignment="Center"/>
                    </StackPanel>

                    <StackPanel Grid.Row="4" Margin="0,14,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="字号" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Style="{StaticResource PlainBox}"
                                         Width="68"
                                         Height="32"
                                         Padding="6,4"
                                         TextAlignment="Center"
                                         Text="{Binding FontSizePt, StringFormat=0, UpdateSourceTrigger=LostFocus}"
                                         KeyDown="CommitOnEnter"/>
                                <TextBlock Text="磅" Width="28" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </Grid>
                        <Slider Margin="0,6,0,0"
                                Minimum="36" Maximum="300" SmallChange="1" LargeChange="10"
                                IsSnapToTickEnabled="True" TickFrequency="1"
                                Value="{Binding FontSizePt}"/>
                    </StackPanel>

                    <StackPanel Grid.Row="5" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="相距" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Style="{StaticResource PlainBox}"
                                         Width="68"
                                         Height="32"
                                         Padding="6,4"
                                         TextAlignment="Center"
                                         Text="{Binding SpacingCm, StringFormat=0.0, UpdateSourceTrigger=LostFocus}"
                                         KeyDown="CommitOnEnter"/>
                                <TextBlock Text="厘米" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </Grid>
                        <Slider Margin="0,6,0,0"
                                Minimum="{Binding SpacingMinimumCm}"
                                Maximum="{Binding SpacingMaximumCm}"
                                SmallChange="0.1"
                                LargeChange="0.5"
                                IsSnapToTickEnabled="True"
                                TickFrequency="0.1"
                                Value="{Binding SpacingCm}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                   Text="上下两个姓名中心的间距。14 厘米时，版式与原来的脚本一致。"/>
                    </StackPanel>

                    <StackPanel Grid.Row="6" Margin="0,12,0,0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="虚线距" Foreground="{StaticResource Muted}" FontSize="13" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <TextBox Style="{StaticResource PlainBox}"
                                         Width="68"
                                         Height="32"
                                         Padding="6,4"
                                         TextAlignment="Center"
                                         Text="{Binding GuideOffsetCm, StringFormat=0.0, UpdateSourceTrigger=LostFocus}"
                                         KeyDown="CommitOnEnter"/>
                                <TextBlock Text="厘米" Width="36" Margin="8,0,0,0" VerticalAlignment="Center" Foreground="{StaticResource Muted}"/>
                            </StackPanel>
                        </Grid>
                        <Slider Margin="0,6,0,0"
                                Minimum="0"
                                Maximum="{Binding GuideOffsetMaximumCm}"
                                SmallChange="0.1"
                                LargeChange="0.5"
                                IsSnapToTickEnabled="True"
                                TickFrequency="0.1"
                                Value="{Binding GuideOffsetCm}"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,6,0,0"
                                   Text="上下两条灰色虚线离姓名外沿的距离。0.5 厘米与原脚本一致，这条线会写进文档。"/>
                    </StackPanel>

                    <StackPanel Grid.Row="7" Margin="0,12,0,0">
                        <CheckBox Foreground="{StaticResource Text}"
                                  IsChecked="{Binding ShowFoldLine}"
                                  Content="预览中显示对折线"/>
                        <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,8,0,0"
                                   Text="灰色虚线在姓名外侧，会打印出来。A4 比透明夹子大，沿这条虚线把多余的纸折进去，再放进夹子。点右侧「立体」可以看这个过程，拖动还能看到另一面。"/>
                    </StackPanel>
                </Grid>
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Background="{StaticResource Card}" CornerRadius="16">
            <DockPanel>
                <Grid DockPanel.Dock="Top" Margin="22,18,22,12">
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="预览" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <RadioButton Content="平面" GroupName="PreviewMode" IsChecked="True" Style="{StaticResource SegmentButton}" Margin="0,0,6,0" Checked="FlatMode_Checked"/>
                            <RadioButton Content="立体" GroupName="PreviewMode" Style="{StaticResource SegmentButton}" Checked="FoldMode_Checked"/>
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Content="‹" Style="{StaticResource PagerButton}" IsEnabled="{Binding CanGoPrevious}" Click="Previous_Click"/>
                        <StackPanel Width="148" Margin="8,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding PreviewName}"
                                       FontSize="15"
                                       FontWeight="SemiBold"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       Foreground="{StaticResource Text}"/>
                            <TextBlock Text="{Binding PageLabel}"
                                       FontSize="12"
                                       TextAlignment="Center"
                                       Foreground="{StaticResource Muted}"
                                       Margin="0,1,0,0"/>
                        </StackPanel>
                        <Button Content="›" Style="{StaticResource PagerButton}" IsEnabled="{Binding CanGoNext}" Click="Next_Click"/>
                    </StackPanel>
                </Grid>

                <TextBlock DockPanel.Dock="Bottom"
                           Margin="22,10,22,16"
                           TextWrapping="Wrap"
                           Foreground="{StaticResource Muted}"
                           FontSize="12"
                           Text="{Binding PreviewHint}"/>

                <Border Margin="22,0,22,0" Background="#E3D9C8" CornerRadius="12" ClipToBounds="True"
                        PreviewMouseWheel="Preview_MouseWheel">
                    <Grid>
                        <controls:SignPreviewControl NameText="{Binding PreviewName}"
                                                     FontName="{Binding FontName}"
                                                     FontSizePt="{Binding FontSizePt}"
                                                     SpacingCm="{Binding SpacingCm}"
                                                     GuideOffsetCm="{Binding GuideOffsetCm}"
                                                     ShowFoldLine="{Binding ShowFoldLine}"
                                                     IsPlaceholder="{Binding IsPlaceholder}"
                                                     Visibility="{Binding IsFoldDemo, Converter={StaticResource InverseBoolToVis}}"/>
                        <controls:FoldDemoControl NameText="{Binding PreviewName}"
                                                  FontName="{Binding FontName}"
                                                  FontSizePt="{Binding FontSizePt}"
                                                  SpacingCm="{Binding SpacingCm}"
                                                  GuideOffsetCm="{Binding GuideOffsetCm}"
                                                  IsPlaceholder="{Binding IsPlaceholder}"
                                                  Visibility="{Binding IsFoldDemo, Converter={StaticResource BoolToVis}}"/>
                    </Grid>
                </Border>
            </DockPanel>
        </Border>
    </Grid>
</Window>
